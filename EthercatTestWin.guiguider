																		"radius": 0,
																		"bg_color": "#e1e6ee",
																		"bg_grad_color": "#ffffff",
																		"bg_grad_dir": "LV_GRAD_DIR_NONE",
																		"bg_main_stop": 0,
																		"bg_grad_stop": 255,
																		"bg_opa": 255,
