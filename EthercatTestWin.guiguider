																				"font_family": "montserratMedium",
																				"bg_opa": 0,
																				"bg_color": "#ffffff",
																				"bg_grad_color": "#ffffff",
																				"bg_grad_dir": "LV_GRAD_DIR_NONE",
																				"bg_main_stop": 0,
																				"bg_grad_stop": 255,
																				"border_side": [
																					"LV_BORDER_SIDE_FULL"
																				],
																				"border_width": 3,
																				"border_color": "#d5dee6",
