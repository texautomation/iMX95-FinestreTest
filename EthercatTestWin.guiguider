																			{
																				"part": "LV_PART_ITEMS",
																				"state": "LV_STATE_DISABLED",
																				"disable": true,
																				"text_color": "#393c41",
																				"text_decor": "LV_TEXT_DECOR_NONE",
																				"font": 12,
																				"text_align": "LV_TEXT_ALIGN_CENTER",
																				"font_family": "montserratMedium",
																				"bg_opa": 0,
																				"bg_color": "#ffffff",
																				"bg_grad_color": "#ffffff",
																				"bg_grad_dir": "LV_GRAD_DIR_NONE",
																				"bg_main_stop": 0,
																				"bg_grad_stop": 255,
																				"border_side": [
																					"LV_BORDER_SIDE_FULL"
																				],
																				"border_width": 3,
																				"border_color": "#d5dee6",
																				"border_opa": 255,
																				"padding_top": 10,
																				"padding_bottom": 10,
